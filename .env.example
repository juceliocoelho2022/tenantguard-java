# Copy this file to .env for local development.
# Never commit the real .env file.

SPRING_PROFILES_ACTIVE=dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-postgres-password
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-local-grafana-password

JWT_ACCESS_EXPIRATION_SECONDS=3600
JWT_REFRESH_EXPIRATION_SECONDS=604800
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_REFRESH_MAX_ATTEMPTS=10

# Observability / tracing
TRACING_SAMPLING_PROBABILITY=0.1
OTLP_TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
